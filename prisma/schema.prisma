generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id                   String                  @id @default(uuid())
  name                 String
  email                String                  @unique
  username             String                  @unique
  profilePicture       String?
  password             String
  description          String?
  meditation           String?
  journaling           String?
  meals                String?
  sleep                String?
  exercise             String?
  questionaireComplete Boolean                 @default(false)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  dailyTasks           DailyMentalHealthTask[]
  meditations          Meditation[]
  activities           Activity[]
  chats                Chat[]
  funFacts             FunFact[]
  journals             Journal[]
  loves                Love[]
  struggles            Struggle[]

  @@map("user_profiles")
}

model DailyMentalHealthTask {
  id                  String      @id @default(uuid())
  userId              String
  date                DateTime    @default(now())
  meditationCompleted Boolean     @default(false)
  journalingCompleted Boolean     @default(false)
  mealsCompleted      Boolean     @default(false)
  sleepCompleted      Boolean     @default(false)
  exerciseCompleted   Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  userProfile         UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "DailyMentalHealthTask_userId_fkey")
}

model Meditation {
  id          String      @id @default(uuid())
  userId      String
  type        String
  startedAt   DateTime
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userProfile UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Meditation_userId_fkey")
}

model Journal {
  id          String      @id @default(uuid())
  title       String
  description String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userId      String
  userProfile UserProfile @relation(fields: [userId], references: [id])

  @@index([userId], map: "journals_userId_fkey")
  @@map("journals")
}

model Love {
  id            String      @id @default(uuid())
  content       String
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId], map: "loves_userProfileId_fkey")
  @@map("loves")
}

model Struggle {
  id            String      @id @default(uuid())
  content       String
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId], map: "struggles_userProfileId_fkey")
  @@map("struggles")
}

model Activity {
  id            String      @id @default(uuid())
  content       String
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId], map: "activities_userProfileId_fkey")
  @@map("activities")
}

model FunFact {
  id            String      @id @default(uuid())
  content       String
  userProfileId String
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId], map: "fun_facts_userProfileId_fkey")
  @@map("fun_facts")
}

model Chat {
  id            String      @id @default(uuid())
  threadsId     String
  userProfileId String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

  @@index([userProfileId], map: "chats_userProfileId_fkey")
  @@map("chats")
}
